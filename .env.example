# Water Quality Monitor — Environment Variables
# Copy this file to .env and fill in your values

# No external API keys required for the core monitoring pipeline.
# The system uses local sensor files and the filesystem MCP.

# Optional: SCADA/telemetry integration
# SCADA_HOST=192.168.1.100
# SCADA_PORT=502
# SCADA_PROTOCOL=modbus

# Optional: Lab LIMS integration (for automated lab result import)
# LIMS_API_URL=https://your-lims.example.com/api
# LIMS_API_KEY=your-lims-api-key

# Optional: State reporting portal (for automated filing submission)
# STATE_PORTAL_URL=https://sdwis.your-state.gov/api
# STATE_PORTAL_USERNAME=your-username
# STATE_PORTAL_PASSWORD=your-password

# Optional: Alert notifications
# ALERT_EMAIL=operator@yourwater.example
# ALERT_SMS_NUMBER=+15551234567
